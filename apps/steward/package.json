{
  "name": "@isaac2ingrid/steward",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config ../../wrangler.jsonc",
    "deploy": "wrangler deploy --config ../../wrangler.jsonc",
    "cf-typegen": "wrangler types --config ../../wrangler.jsonc worker-configuration.d.ts",
    "typecheck": "wrangler types --config ../../wrangler.jsonc worker-configuration.d.ts && tsc --noEmit",
    "test": "node scripts/test-groups.mjs",
    "test:node": "STEWARD_TEST_RUNTIME=node node scripts/test-groups.mjs",
    "eval:routing": "node eval/run-eval.ts",
    "eval:routing:selftest": "node eval/run-eval.ts --selftest",
    "build:node": "node scripts/build-node.mjs",
    "dev:node": "node scripts/build-node.mjs && node dist/node/steward-node.mjs",
    "start:node": "node dist/node/steward-node.mjs",
    "typecheck:node-host": "tsc -p tsconfig.node-host.json"
  },
  "dependencies": {
    "@isaac2ingrid/protocol": "workspace:*",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@simplewebauthn/server": "^14.0.3",
    "agents": "0.28.1",
    "uqr": "^0.1.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.3",
    "@earendil-works/chord": "1.3.0",
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.12",
    "wrangler": "4.151.0"
  },
  "license": "MIT"
}
